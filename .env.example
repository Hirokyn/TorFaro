# Endereço do seu Prowlarr, visto de dentro do container.
# Use o IP ou o nome do host na rede. "localhost" apontaria para o próprio container.
PROWLARR_URL=http://192.0.2.10:9696

# Em Prowlarr > Settings > General > API Key. Fica somente no servidor.
PROWLARR_API_KEY=

# Opcional, lido pelo docker-compose.yml. Veja "Acesso pela rede" no manual.
# APP_BIND=0.0.0.0
# APP_PORT=3000
